# syntax=docker/dockerfile:1

FROM golang:1.24-alpine AS builder
WORKDIR /src
RUN apk add --no-cache git
ENV GOTOOLCHAIN=auto
COPY go.mod ./
RUN go mod download || true
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/opeteer .

FROM alpine:3.20 AS runner
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /bin/opeteer /usr/local/bin/opeteer
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/opeteer"]
CMD ["serve", "--port", "8081"]
